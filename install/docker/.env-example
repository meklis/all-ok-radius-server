# Radius secret
RADIUS_SECRET=secret

#Интерфейс и порт, который слушает радиус
RADIUS_LISTEN_ADDR=0.0.0.0:1812

# Адрес API (processor: api)
API_ADDR=http://radius-api:8080/v1

# Адрес базы устройств/привязок (processor: script, обязателен для него)
CLIENTDB_URL=https://example.com/radius/database
